</Layout>

<script is:inline define:vars={{ dict, VERSION }}>
  /* ── Language ─────────────────────────────────────────────────────── */
  var LANGS = { en: 'en', 'zh-hans': 'zh-Hans', 'zh-hant': 'zh-Hant' };
  function tr(lang, key) {
    var d = dict[lang] || dict.en;
    var s = d[key] != null ? d[key] : dict.en[key];
    return s == null ? null : String(s).replace('{v}', VERSION);
  }
  function applyLang(lang) {
    if (!dict[lang]) lang = 'en';
    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      var s = tr(lang, el.getAttribute('data-i18n'));
      if (s != null) el.textContent = s;
    });
    document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
      var s = tr(lang, el.getAttribute('data-i18n-alt'));
      if (s != null) el.setAttribute('alt', s);
    });
    document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
      var s = tr(lang, el.getAttribute('data-i18n-aria'));
      if (s != null) { el.setAttribute('aria-label', s); el.setAttribute('title', s); }
    });
    document.querySelectorAll('.seg-btn[data-lang]').forEach(function (b) {
      var on = b.getAttribute('data-lang') === lang;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    document.documentElement.lang = LANGS[lang];
  }
  var saved = 'en';
  try { saved = localStorage.getItem('lb-lang') || 'en'; } catch (e) {}
  if (saved !== 'en') applyLang(saved);
  else document.documentElement.lang = 'en';
  document.querySelectorAll('.seg-btn[data-lang]').forEach(function (b) {
    b.addEventListener('click', function () {
      var lang = b.getAttribute('data-lang');
      try { localStorage.setItem('lb-lang', lang); } catch (e) {}
      applyLang(lang);
    });
  });

  /* ── Theme (same key as before: lb-theme, default dark) ───────────── */
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    try { localStorage.setItem('lb-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });

  /* ── Header: solid once the page scrolls ──────────────────────────── */
  var header = document.querySelector('.site-header');
  function onScroll() { header.classList.toggle('is-stuck', window.scrollY > 8); }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ── Screenshot tabs ──────────────────────────────────────────────── */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab[role="tab"]'));
  function selectTab(tab, focus) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    if (focus) tab.focus();
  }
  tabs.forEach(function (tab, i) {
    tab.addEventListener('click', function () { selectTab(tab); });
    tab.addEventListener('keydown', function (e) {
      var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      selectTab(tabs[(i + d + tabs.length) % tabs.length], true);
    });
  });

  /* ── Hero video: attach sources only when it makes sense ──────────── */
  (function () {
    var v = document.querySelector('.hero-video');
    if (!v) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var wide = window.matchMedia('(min-width: 721px)');
    function allowed() {
      var c = navigator.connection;
      var slow = c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || ''));
      return !reduce.matches && wide.matches && !slow;
    }
    var attached = false, visible = true;
    function attach() {
      if (attached || !allowed()) return;
      attached = true;
      [['webm', 'video/webm; codecs="vp9"'], ['mp4', 'video/mp4; codecs="avc1.640028"']].forEach(function (s) {
        var el = document.createElement('source');
        el.src = v.getAttribute('data-src-' + s[0]);
        el.type = s[1];
        v.appendChild(el);
      });
      v.load();
      sync();
    }
    function sync() {
      if (!attached) return;
      if (visible && !document.hidden && !reduce.matches) {
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      } else v.pause();
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; sync(); }).observe(v);
    }
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener && reduce.addEventListener('change', function () { attach(); sync(); });
    wide.addEventListener && wide.addEventListener('change', attach);
    if (document.readyState === 'complete') attach();
    else window.addEventListener('load', attach);
  })();
</script>

<style>
  /* ── Layout primitives ─────────────────────────────────────────────── */
  .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--accent);
    color: var(--accent-fg);
    border-radius: var(--radius);
    font-size: 13px;
  }
  .skip:focus { top: 12px; }

  /* ── Hero background video ─────────────────────────────────────────── */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 0;
    height: clamp(520px, 56.25vw, 900px);
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: lighten;
    -webkit-mask-image: linear-gradient(180deg, #000 0 50%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 0 50%, transparent 92%);
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    background: #0a0a0a;
  }
  /* Light theme: the same loop as a negative — ink on paper — with the red
     pulse kept red (hue-rotate undoes the inversion's hue flip). */
  :global(html:not(.dark)) .hero-bg {
    mix-blend-mode: darken;
    filter: invert(1) hue-rotate(180deg) contrast(0.9) brightness(1.1);
    opacity: 0.9;
  }
  @media (max-width: 720px) {
    .hero-video { object-position: 78% 0; }
    .hero-bg { height: 520px; opacity: 0.75; }
  }

  /* ── Header ───────────────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background-color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .site-header.is-stuck {
    background: var(--header-bg);
    border-bottom-color: var(--border);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    backdrop-filter: saturate(140%) blur(14px);
  }
  .header-row {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .brand img { border-radius: 6px; box-shadow: 0 0 0 1px var(--border); }
  .brand-word {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nav { display: flex; gap: 26px; }
  .nav a, .footer-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s;
  }
  .nav a:hover, .footer-links a:hover { color: var(--fg); }
  .header-tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }

  .seg {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .seg-btn {
    height: 26px;
    padding: 0 9px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.12s, background-color 0.12s;
  }
  .seg-btn[lang='en'] { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; }
  .seg-btn:hover { color: var(--fg); }
  .seg-btn.is-active { background: var(--overlay-strong); color: var(--fg); }

  .icon-btn {
    width: 32px;
    height: 32px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius);
    color: var(--muted);
    transition: color 0.12s, background-color 0.12s;
  }
  .icon-btn:hover { color: var(--fg); background: var(--overlay-strong); }
  .when-light { display: none; }
  :global(html:not(.dark)) .when-dark { display: none; }
  :global(html:not(.dark)) .when-light { display: block; }

  /* ── Buttons ──────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 26px;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    transition: filter 0.15s, background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .btn { text-shadow: none; }
  .btn:active { transform: translateY(1px); }
  .btn .arr { display: inline-flex; transition: transform 0.18s var(--ease); }
  .btn:hover .arr { transform: translateX(4px); }
  .btn-sm { padding: 9px 14px; font-size: 12px; letter-spacing: 1px; border-radius: var(--radius); }
  .btn-primary { background: var(--accent); color: var(--accent-fg); }
  .btn-primary:hover { filter: brightness(0.9); }
  :global(html:not(.dark)) .btn-primary:hover { filter: brightness(1.35); }
  .btn-ghost { border-color: var(--border-strong); color: var(--fg); background: color-mix(in srgb, var(--bg) 55%, transparent); }
  .btn-ghost:hover { border-color: var(--fg); }
  .text-link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 4px 2px;
    border-bottom: 1px solid var(--border-strong);
    transition: color 0.15s, border-color 0.15s;
  }
  .text-link:hover { color: var(--fg); border-color: var(--fg); }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero { position: relative; z-index: 1; padding-top: clamp(40px, 4.4vw, 64px); }
  .hero-copy { text-shadow: 0 0 2px var(--bg), 0 0 14px var(--bg); }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--punch);
  }
  .sq { width: 8px; height: 8px; background: currentColor; flex-shrink: 0; }
  .h1 {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: clamp(30px, 3.05vw, 44px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .h1 > span { display: block; }
  .punch { color: var(--punch); }
  .lede {
    margin-top: 22px;
    max-width: 62ch;
    font-size: clamp(16px, 1.35vw, 18px);
    font-weight: 450;
    line-height: 1.6;
    color: var(--muted);
  }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 28px; }
  .cta-row .text-link { margin-left: 8px; }
  .note {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  /* Window frame used by every full screenshot. */
  .window {
    position: relative;
    container-type: inline-size;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: #0a0a0a;
    box-shadow: var(--shadow-frame);
  }
  .window img { width: 100%; height: auto; }
  /* macOS traffic lights at (13,13) of the 1280px window, inactive grey. */
  .lights {
    position: absolute;
    left: calc(13 / 1280 * 100cqw);
    top: calc(13 / 1280 * 100cqw);
    display: flex;
    gap: calc(8 / 1280 * 100cqw);
    pointer-events: none;
  }
  .lights i {
    width: calc(12 / 1280 * 100cqw);
    height: calc(12 / 1280 * 100cqw);
    border-radius: 50%;
    background: #3a3a3c;
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.08);
  }

  .hero-shot {
    position: relative;
    z-index: 1;
    width: calc(100% - 2 * var(--pad));
    max-width: 1318px;
    margin: clamp(36px, 3.6vw, 52px) auto 0;
  }
  .hero-shot .window { border-radius: 12px; box-shadow: var(--shadow-hero); }

  .cap {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 36px;
  }
  .stat {
    padding: 16px 18px;
    border: 1px solid var(--border);
    margin: -1px 0 0 -1px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .stat:first-child { border-radius: var(--radius-lg) 0 0 var(--radius-lg); }
  .stat:last-child { border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .stat dt {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stat dd { margin-top: 6px; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .section { margin-top: clamp(96px, 10vw, 148px); }
  .label-row { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
  .label-num {
    font-family: var(--font-mono);
    font-size: clamp(26px, 3.4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--punch);
  }
  .rule { flex: 1; height: 1px; background: var(--border); }
  .label-name {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .h2 {
    font-family: var(--font-mono);
    font-size: clamp(30px, 4.6vw, 58px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 22ch;
  }
  .h2-sm { font-size: clamp(26px, 3.2vw, 40px); max-width: 18ch; letter-spacing: -0.04em; }
