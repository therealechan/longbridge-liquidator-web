---
import Layout from '../layouts/Layout.astro';
import { dict, t, VERSION } from '../i18n';

const REPO = 'https://github.com/therealechan/longbridge-liquidator-web';
const LATEST = `${REPO}/releases/latest`;
const RELEASES = `${REPO}/releases`;
const CHANGELOG = `${REPO}/blob/master/CHANGELOG.md`;
const WHATSNEW = `${REPO}/releases/tag/${VERSION}`;

// Lucide icons (ISC), inlined so the page makes no CDN requests.
const ICONS: Record<string, string> = {
  window: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4"/><path d="M2 8h20"/><path d="M6 4v4"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  crosshair: '<circle cx="12" cy="12" r="10"/><path d="M22 12h-4"/><path d="M6 12H2"/><path d="M12 6V2"/><path d="M12 22v-4"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/>',
  candles: '<path d="M9 5v4"/><rect width="4" height="6" x="7" y="9" rx="1"/><path d="M9 15v2"/><path d="M17 3v2"/><rect width="4" height="8" x="15" y="5" rx="1"/><path d="M17 13v3"/><path d="M3 3v16a2 2 0 0 0 2 2h16"/>',
  history: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  command: '<path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>',
  network: '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  key: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  toggle: '<rect width="20" height="12" x="2" y="6" rx="6" ry="6"/><circle cx="8" cy="12" r="2"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  download: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
};
const icon = (name: string, size = 18) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
const GITHUB_PATH =
  'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.745 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z';

// Screenshot crops (source images are 1280×800). Percent margins resolve
// against the frame width, so one image crops to any rectangle.
const SRC_W = 1280;
const crop = (x: number, y: number, w: number, h: number) => ({
  frame: `aspect-ratio:${w}/${h}`,
  img: `width:${(SRC_W / w) * 100}%;max-width:none;margin-left:-${(x / w) * 100}%;margin-top:-${(y / w) * 100}%`,
});
const C_POS = crop(0, 0, 660, 500);
const C_SELL = crop(332, 0, 648, 430);
const C_DETAILS = crop(640, 0, 640, 660);
const C_ORDERS = crop(0, 0, 820, 400);

// Anatomy regions on the 1280×800 window.
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
const REGIONS = [
  { n: '01', k: 'rail', x: 0, y: 0, w: 52, h: 774 },
  { n: '02', k: 'sidebar', x: 52, y: 0, w: 280, h: 774 },
  { n: '03', k: 'tabs', x: 332, y: 0, w: 648, h: 44 },
  { n: '04', k: 'details', x: 980, y: 0, w: 300, h: 774 },
  { n: '05', k: 'status', x: 0, y: 774, w: 1280, h: 26 },
] as const;

const FEATURES = [
  { i: 'window', k: 'shell', meta: '⌘B · ⌘D · ⌘1/2/3' },
  { i: 'zap', k: 'liq', meta: 'All · 1/2 · 1/3 · 1/4' },
  { i: 'crosshair', k: 'cond', meta: 'SL · TP · Trailing' },
  { i: 'undo', k: 'buy', meta: 'Snapshot → market' },
  { i: 'candles', k: 'chart', meta: 'Today · 1M · 3M · 1Y' },
  { i: 'history', k: 'orders', meta: 'Sell · Buy · Cond.' },
  { i: 'shield', k: 'sec', meta: '127.0.0.1:3456' },
  { i: 'command', k: 'kbd', meta: '⌘/ all shortcuts' },
] as const;

const SECURITY = [
  { i: 'network', n: 1 },
  { i: 'key', n: 2 },
  { i: 'lock', n: 3 },
  { i: 'toggle', n: 4 },
  { i: 'code', n: 5 },
] as const;

const SHOTS = [
  { k: 'dark', src: '/screenshots/dark-positions.png' },
  { k: 'light', src: '/screenshots/light-positions.png' },
  { k: 'chart', src: '/screenshots/chart.png' },
  { k: 'orders', src: '/screenshots/orders.png' },
  { k: 'settings', src: '/screenshots/api-config.png' },
] as const;

const MODAL_ROWS = [
  ['AAPL.US', '100', '$18,550.00'],
  ['TSLA.US', '50', '$12,115.00'],
  ['NVDA.US', '25', '$21,880.00'],
  ['00700.HK', '200', 'HK$77,120.00'],
];

const T = t as (k: string) => string;
---

<Layout>
  <a class="skip" href="#main" data-i18n="skip">{t('skip')}</a>

  <!-- Hero background: the generated loop. Sources are attached by script
       after load (desktop, motion allowed, no Save-Data); otherwise the
       poster (frame 0) stays as a still. -->
  <div class="hero-bg" aria-hidden="true">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      autoplay
      preload="none"
      poster="/video/hero-poster.jpg"
      width="1600"
      height="900"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
      data-src-webm="/video/hero-loop.webm"
      data-src-mp4="/video/hero-loop.mp4"></video>
  </div>

  <!-- ═══ Header ═══════════════════════════════════════════════════════ -->
  <header class="site-header" id="top">
    <div class="wrap header-row">
      <a href="#top" class="brand" aria-label="LB Liquidator">
        <img src="/icon.png" width="26" height="26" alt="" />
        <span class="brand-word">LB Liquidator</span>
      </a>

      <nav class="nav" aria-label="Primary">
        <a href="#features" data-i18n="nav_features">{t('nav_features')}</a>
        <a href="#native" data-i18n="nav_native">{t('nav_native')}</a>
        <a href="#security" data-i18n="nav_security">{t('nav_security')}</a>
        <a href="#screenshots" data-i18n="nav_screens">{t('nav_screens')}</a>
      </nav>

      <div class="header-tools">
        <div class="seg" role="group" aria-label="Language">
          <button class="seg-btn is-active" data-lang="en" aria-pressed="true" lang="en">EN</button>
          <button class="seg-btn" data-lang="zh-hans" aria-pressed="false" lang="zh-Hans">中文</button>
          <button class="seg-btn" data-lang="zh-hant" aria-pressed="false" lang="zh-Hant">繁中</button>
        </div>
        <button id="theme-toggle" class="icon-btn" aria-label={t('theme_toggle')} title={t('theme_toggle')} data-i18n-aria="theme_toggle">
          <span class="when-dark" set:html={icon('sun', 17)} />
          <span class="when-light" set:html={icon('moon', 17)} />
        </button>
        <a href={REPO} class="icon-btn" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={GITHUB_PATH} /></svg>
        </a>
        <a href="#download" class="btn btn-primary btn-sm header-cta" data-i18n="nav_download">{t('nav_download')}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ═══ Hero ═══════════════════════════════════════════════════════ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <p class="eyebrow"><span class="sq" aria-hidden="true"></span><span data-i18n="hero_eyebrow">{t('hero_eyebrow')}</span></p>
        <h1 id="hero-title" class="h1">
          <span data-i18n="hero_title_a">{T('hero_title_a')}</span>
          <span class="punch" data-i18n="hero_title_b">{T('hero_title_b')}</span>
        </h1>
        <p class="lede" data-i18n="hero_sub">{t('hero_sub')}</p>
        <div class="cta-row">
          <a href={LATEST} class="btn btn-primary" target="_blank" rel="noopener">
            <Fragment set:html={icon('download', 17)} />
            <span data-i18n="cta_download">{t('cta_download')}</span>
            <span class="arr" set:html={icon('arrow', 16)} />
          </a>
          <a href={REPO} class="btn btn-ghost" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={GITHUB_PATH} /></svg>
            <span data-i18n="cta_github">{t('cta_github')}</span>
          </a>
          <a href={WHATSNEW} class="text-link" target="_blank" rel="noopener" data-i18n="cta_whatsnew">{T('cta_whatsnew')}</a>
        </div>
        <p class="note" data-i18n="hero_note">{t('hero_note')}</p>
      </div>

      <figure class="hero-shot">
        <div class="window">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <img
            src="/screenshots/chart.png"
            width="1280"
            height="800"
            alt={t('hero_shot_alt')}
            data-i18n-alt="hero_shot_alt"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="cap" data-i18n="shot_cap">{T('shot_cap')}</figcaption>
      </figure>

      <dl class="wrap stats">
        {[1, 2, 3, 4].map((n) => (
          <div class="stat">
            <dt data-i18n={`stat_${n}_k`}>{T(`stat_${n}_k`)}</dt>
            <dd class="mono num" data-i18n={`stat_${n}_v`}>{T(`stat_${n}_v`)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ═══ 01 Features ═════════════════════════════════════════════════ -->
    <section class="section wrap" id="features" aria-labelledby="feat-title">
      <div class="label-row"><span class="label-num">01</span><span class="rule"></span><span class="label-name" data-i18n="feat_name">{T('feat_name')}</span></div>
      <h2 id="feat-title" class="h2" data-i18n="feat_title">{t('feat_title')}</h2>
      <p class="lead" data-i18n="feat_sub">{t('feat_sub')}</p>
      <ul class="feat-grid">
        {FEATURES.map((f) => (
          <li class="feat">
            <span class="feat-icon" set:html={icon(f.i, 18)} />
            <h3 class="feat-title" data-i18n={`f_${f.k}_t`}>{T(`f_${f.k}_t`)}</h3>
            <p class="feat-desc" data-i18n={`f_${f.k}_d`}>{T(`f_${f.k}_d`)}</p>
            <p class="feat-meta mono">{f.meta}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ═══ 02 Positions ════════════════════════════════════════════════ -->
    <section class="section wrap" aria-labelledby="ch2-title">
      <div class="label-row"><span class="label-num">02</span><span class="rule"></span><span class="label-name" data-i18n="ch2_name">{T('ch2_name')}</span></div>
      <div class="split">
        <div class="split-text">
          <h2 id="ch2-title" class="h2 h2-sm" data-i18n="ch2_title">{T('ch2_title')}</h2>
          <p class="lead" data-i18n="ch2_lead">{T('ch2_lead')}</p>
          <ul class="points">
            <li data-i18n="ch2_p1">{T('ch2_p1')}</li>
            <li data-i18n="ch2_p2">{T('ch2_p2')}</li>
            <li data-i18n="ch2_p3">{T('ch2_p3')}</li>
          </ul>
        </div>
        <figure class="media">
          <div class="frame crop fade-r" style={C_POS.frame}>
            <img src="/screenshots/chart.png" width="1280" height="800" style={C_POS.img} alt={T('ch2_alt')} data-i18n-alt="ch2_alt" loading="lazy" decoding="async" />
          </div>
          <figcaption class="cap" data-i18n="ch2_cap">{T('ch2_cap')}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 03 Liquidate ════════════════════════════════════════════════ -->
    <section class="section wrap" aria-labelledby="ch3-title">
      <div class="label-row"><span class="label-num">03</span><span class="rule"></span><span class="label-name" data-i18n="ch3_name">{T('ch3_name')}</span></div>
      <div class="split flip">
        <div class="split-text">
          <h2 id="ch3-title" class="h2 h2-sm" data-i18n="ch3_title">{T('ch3_title')}</h2>
          <p class="lead" data-i18n="ch3_lead">{T('ch3_lead')}</p>
          <ul class="points">
            <li data-i18n="ch3_p1">{T('ch3_p1')}</li>
            <li data-i18n="ch3_p2">{T('ch3_p2')}</li>
            <li data-i18n="ch3_p3">{T('ch3_p3')}</li>
          </ul>
        </div>
        <figure class="media">
          <div class="stage">
            <div class="frame crop" style={C_SELL.frame}>
              <img src="/screenshots/chart.png" width="1280" height="800" style={C_SELL.img} alt={T('ch3_alt')} data-i18n-alt="ch3_alt" loading="lazy" decoding="async" />
            </div>
            <!-- The app's liquidation confirmation, rebuilt with its tokens. -->
            <div class="modal" aria-hidden="true">
              <div class="modal-head">
                <span class="modal-icon" set:html={icon('zap', 16)} />
                <span data-i18n="mm_title">{T('mm_title')}</span>
                <span class="badge">Demo</span>
              </div>
              <p class="modal-body" data-i18n="mm_body">{T('mm_body')}</p>
              <table class="modal-table mono num">
                <tbody>
                  {MODAL_ROWS.map(([s, q, v]) => (
                    <tr><td>{s}</td><td>{q}</td><td>{v}</td></tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr><td data-i18n="mm_total">{T('mm_total')}</td><td></td><td>$52,545.00<br />HK$77,120.00</td></tr>
                </tfoot>
              </table>
              <div class="modal-actions">
                <span class="mbtn mbtn-outline" data-i18n="mm_cancel">{T('mm_cancel')}</span>
                <span class="mbtn mbtn-danger"><span data-i18n="mm_confirm">{T('mm_confirm')}</span><span class="kbd-hint">⌘↩</span></span>
              </div>
            </div>
          </div>
          <figcaption class="cap" data-i18n="ch3_cap">{T('ch3_cap')}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 04 Details ══════════════════════════════════════════════════ -->
    <section class="section wrap" aria-labelledby="ch4-title">
      <div class="label-row"><span class="label-num">04</span><span class="rule"></span><span class="label-name" data-i18n="ch4_name">{T('ch4_name')}</span></div>
      <div class="split">
        <div class="split-text">
          <h2 id="ch4-title" class="h2 h2-sm" data-i18n="ch4_title">{T('ch4_title')}</h2>
          <p class="lead" data-i18n="ch4_lead">{T('ch4_lead')}</p>
          <ul class="points">
            <li data-i18n="ch4_p1">{T('ch4_p1')}</li>
            <li data-i18n="ch4_p2">{T('ch4_p2')}</li>
            <li data-i18n="ch4_p3">{T('ch4_p3')}</li>
          </ul>
        </div>
        <figure class="media">
          <div class="frame crop fade-l" style={C_DETAILS.frame}>
            <img src="/screenshots/chart.png" width="1280" height="800" style={C_DETAILS.img} alt={T('ch4_alt')} data-i18n-alt="ch4_alt" loading="lazy" decoding="async" />
          </div>
          <figcaption class="cap" data-i18n="ch4_cap">{T('ch4_cap')}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 05 History ══════════════════════════════════════════════════ -->
    <section class="section wrap" aria-labelledby="ch5-title">
      <div class="label-row"><span class="label-num">05</span><span class="rule"></span><span class="label-name" data-i18n="ch5_name">{T('ch5_name')}</span></div>
      <div class="split flip">
        <div class="split-text">
          <h2 id="ch5-title" class="h2 h2-sm" data-i18n="ch5_title">{T('ch5_title')}</h2>
          <p class="lead" data-i18n="ch5_lead">{T('ch5_lead')}</p>
          <ul class="points">
            <li data-i18n="ch5_p1">{T('ch5_p1')}</li>
            <li data-i18n="ch5_p2">{T('ch5_p2')}</li>
            <li data-i18n="ch5_p3">{T('ch5_p3')}</li>
          </ul>
        </div>
        <figure class="media">
          <div class="frame crop fade-r" style={C_ORDERS.frame}>
            <img src="/screenshots/orders.png" width="1280" height="800" style={C_ORDERS.img} alt={T('ch5_alt')} data-i18n-alt="ch5_alt" loading="lazy" decoding="async" />
          </div>
          <figcaption class="cap" data-i18n="ch5_cap">{T('ch5_cap')}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 06 Native ═══════════════════════════════════════════════════ -->
    <section class="section wrap" id="native" aria-labelledby="native-title">
      <div class="label-row"><span class="label-num">06</span><span class="rule"></span><span class="label-name" data-i18n="native_name">{T('native_name')}</span></div>
      <p class="kicker" data-i18n="native_label">{t('native_label')}</p>
      <h2 id="native-title" class="h2" data-i18n="native_title">{t('native_title')}</h2>
      <p class="lead" data-i18n="native_sub">{t('native_sub')}</p>

      <figure class="anatomy">
        <div class="window anatomy-window">
          <img src="/screenshots/dark-positions.png" width="1280" height="800" alt={T('anat_alt')} data-i18n-alt="anat_alt" loading="lazy" decoding="async" />
          {REGIONS.map((r) => (
            <span
              class={`region region-${r.k}`}
              style={`left:${pct(r.x, 1280)};top:${pct(r.y, 800)};width:${pct(r.w, 1280)};height:${pct(r.h, 800)}`}
              aria-hidden="true"><b class="mono">{r.n}</b></span>
          ))}
        </div>
        <figcaption class="cap" data-i18n="anat_cap">{T('anat_cap')}</figcaption>
      </figure>

      <ol class="legend">
        {REGIONS.map((r) => (
          <li>
            <span class="legend-n mono">{r.n}</span>
            <h3 data-i18n={`anat_${r.k === 'status' ? 'status' : r.k}_t`}>{T(`anat_${r.k}_t`)}</h3>
            <p data-i18n={`anat_${r.k}_d`}>{T(`anat_${r.k}_d`)}</p>
          </li>
        ))}
      </ol>

      <div class="compare">
        <p class="kicker" data-i18n="cmp_label">{T('cmp_label')}</p>
        <table class="cmp">
          <thead>
