let currentLang = localStorage.getItem('lb-lang') || 'en';

function applyLang(lang) {
  const t = i18n[lang] || i18n.en;
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    const key = el.getAttribute('data-i18n');
    if (t[key] !== undefined) {
      // Preserve children (like version badge in download btn)
      const badge = el.querySelector('.version-badge');
      if (badge) {
        el.childNodes.forEach(function(node) {
          if (node.nodeType === Node.TEXT_NODE) node.remove();
        });
        el.insertBefore(document.createTextNode(t[key]), el.firstChild);
      } else if (key === 'hero_tagline') {
        el.innerHTML = t[key].replace(/\n/g, '<br />');
      } else {
        el.textContent = t[key];
      }
    }
  });

  // Update lang buttons
  document.querySelectorAll('.lang-btn').forEach(function(btn) {
    btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
  });

  // Update html lang
  document.documentElement.lang = lang === 'zh-hans' ? 'zh-Hans' : lang === 'zh-hant' ? 'zh-Hant' : 'en';
}

function switchLang(lang) {
  currentLang = lang;
  localStorage.setItem('lb-lang', lang);
  applyLang(lang);
}

/* ── Theme toggle ── */
function getTheme() {
  return localStorage.getItem('lb-theme') || 'dark';
}

function applyTheme(theme) {
  document.documentElement.classList.toggle('dark', theme === 'dark');
  var lightIcon = document.querySelector('.theme-icon-light');
  var darkIcon = document.querySelector('.theme-icon-dark');
  if (lightIcon) lightIcon.style.display = theme === 'dark' ? 'block' : 'none';
  if (darkIcon) darkIcon.style.display = theme === 'dark' ? 'none' : 'block';
}

document.getElementById('theme-toggle').addEventListener('click', function() {
  var next = getTheme() === 'dark' ? 'light' : 'dark';
  localStorage.setItem('lb-theme', next);
  applyTheme(next);
});

/* ── Screenshot tabs ── */
function switchTab(name) {
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
  document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
  var panel = document.getElementById('tab-' + name);
  if (panel) panel.classList.add('active');
  var btn = document.querySelector('[data-tab="' + name + '"]');
  if (btn) btn.classList.add('active');
}

/* ── Dynamic download button ── */
function setDownloadLoading(loading) {
  var icon1 = document.getElementById('download-btn-icon');
  if (loading) {
    icon1.innerHTML = '<div class="download-spinner"></div>';
  } else {
    icon1.innerHTML = '<i data-lucide="download" style="width:16px;height:16px"></i>';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
}

function setDownloadUrl(url, version) {
  var btn1 = document.getElementById('download-btn');
  var btn2 = document.getElementById('download-btn-2');
  var v1 = document.getElementById('download-version');
  var v2 = document.getElementById('download-version-2');

  if (btn1) btn1.href = url;
  if (btn2) btn2.href = url;

  if (version) {
    if (v1) { v1.textContent = version; v1.style.display = 'inline'; }
    if (v2) { v2.textContent = version; v2.style.display = 'inline'; }
  }
}

async function fetchRelease() {
  setDownloadLoading(true);
  try {
    var res = await fetch('https://api.github.com/repos/therealechan/longbridge-liquidator-web/releases/latest');
    if (!res.ok) throw new Error('HTTP ' + res.status);
    var data = await res.json();
    var version = data.tag_name || '';
    var asset = (data.assets || []).find(function(a) { return a.name && a.name.endsWith('.dmg'); });
    if (asset && asset.browser_download_url) {
      setDownloadUrl(asset.browser_download_url, version);
    } else {
      setDownloadUrl('https://github.com/therealechan/longbridge-liquidator-web/releases', version);
    }
  } catch (e) {
    // Keep fallback URL already set
    console.warn('Release fetch failed:', e);
  } finally {
    setDownloadLoading(false);
  }
}

/* ── Init ── */
(function init() {
  applyTheme(getTheme());
  applyLang(currentLang);
  fetchRelease();
})();
