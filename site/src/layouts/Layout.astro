---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@fontsource/geist-mono/700.css';
import '@fontsource/geist-mono/800.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'LB Liquidator — One-click liquidation for Longbridge, built like a native Mac app',
  description = 'A local-only macOS app for Longbridge Securities: one-click liquidation with ratios and confirmation, conditional orders, buy back, real-time charts and live quotes, order history and keyboard shortcuts. Free and open source.',
  ogImage = '/screenshots/chart.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogUrl = new URL(ogImage, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LB Liquidator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="LB Liquidator in dark mode with positions, the liquidation table and a real-time chart" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/screenshots/chart.png" fetchpriority="high" />

    <!-- Apply the saved theme before first paint (default: dark). -->
    <script is:inline>
      try {
        if ((localStorage.getItem('lb-theme') || 'dark') === 'light') document.documentElement.classList.remove('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ── Tokens (from the app's DESIGN_GUIDELINE.md) ─────────────────────── */
  :root {
    --bg: #ffffff;
    --surface: #f4f4f5;
    --surface-2: #fafafa;
    --border: #e4e4e7;
    --border-soft: #f0f0f1;
    --border-strong: #d4d4d8;
    --fg: #18181b;
    --fg-2: #3f3f46;
    --muted: #71717a;
    --muted-2: #a1a1aa;
    --accent: #18181b;
    --accent-fg: #fafafa;
    --overlay: rgba(0, 0, 0, 0.05);
    --overlay-strong: rgba(0, 0, 0, 0.07);
    --sell: #dc2626;
    --sell-hover: #b91c1c;
    --sell-soft: rgba(220, 38, 38, 0.1);
    --buy: #16a34a;
    --live: #d97706;
    --punch: #dc2626;
    --grid-line: rgba(0, 0, 0, 0.035);
    --grid-line-2: rgba(0, 0, 0, 0.02);
    --shadow-frame: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 0 0 1px rgba(0, 0, 0, 0.02), 0 24px 64px rgba(0, 0, 0, 0.12);
    --shadow-hero: 0 0 0 1px rgba(0, 0, 0, 0.02), 0 30px 90px rgba(0, 0, 0, 0.18), 0 8px 24px rgba(0, 0, 0, 0.06);
    --shadow-menu: 0 0 0 1px rgba(0, 0, 0, 0.06), 0 8px 24px rgba(0, 0, 0, 0.12);
    --header-bg: rgba(255, 255, 255, 0.78);

    --font-sans: 'Geist Variable', 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'PingFang TC', 'Helvetica Neue', sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, Monaco, 'PingFang SC', 'PingFang TC', monospace;
    --radius: 6px;
    --radius-lg: 8px;
    --maxw: 1240px;
    --pad: 36px;
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    color-scheme: light;
  }

  .dark {
    --bg: #0a0a0a;
    --surface: #171717;
    --surface-2: #0f0f0f;
    --border: #262626;
    --border-soft: #1f1f1f;
    --border-strong: #3f3f46;
    --fg: #ededed;
    --fg-2: #d4d4d4;
    --muted: #a1a1aa;
    --muted-2: #71717a;
    --accent: #fafafa;
    --accent-fg: #171717;
    --overlay: rgba(255, 255, 255, 0.05);
    --overlay-strong: rgba(255, 255, 255, 0.08);
    --sell: #dc2626;
    --sell-hover: #ef4444;
    --sell-soft: rgba(239, 68, 68, 0.12);
    --buy: #22c55e;
    --live: #f59e0b;
    --punch: #ef4444;
    --grid-line: rgba(255, 255, 255, 0.026);
    --grid-line-2: rgba(255, 255, 255, 0.015);
    --shadow-frame: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 24px 64px rgba(0, 0, 0, 0.4);
    --shadow-hero: 0 1px 0 rgba(255, 255, 255, 0.05) inset, 0 0 0 1px rgba(255, 255, 255, 0.02), 0 40px 120px rgba(0, 0, 0, 0.7), 0 0 80px rgba(255, 255, 255, 0.025);
    --shadow-menu: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 8px 24px rgba(0, 0, 0, 0.5);
    --header-bg: rgba(10, 10, 10, 0.72);
    color-scheme: dark;
  }

  @media (max-width: 540px) {
    :root { --pad: 20px; }
  }

  /* ── Base ───────────────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    background: var(--bg);
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  body {
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    overflow-x: hidden;
  }

  /* The faint page grid behind everything (shows through the video's
     `lighten` blend, so the hero and the page share one surface). */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 43px, var(--grid-line) 43px 44px),
      repeating-linear-gradient(90deg, transparent 0 59px, var(--grid-line-2) 59px 60px);
  }

  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  img, video, svg { display: block; max-width: 100%; }
  :focus { outline: none; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  ::selection { background: var(--fg); color: var(--bg); }

  .mono { font-family: var(--font-mono); }
  .num { font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
</style>
